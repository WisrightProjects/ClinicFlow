<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon background: the Clinik brand gradient.
     Colours sampled from client/public/favicon.png (top-left -> bottom-right).
     angle=315 runs the gradient from the top-left corner to the bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#35A3E7"
        android:endColor="#103CB4"
        android:type="linear" />
</shape>
