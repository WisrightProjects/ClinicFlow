# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Session Configuration
SESSION_SECRET="your-session-secret"

# Payments
# Controls the "Online" option on the booking payment screen:
#   dummy (default) - simulated payment. Books the token WITHOUT collecting any money.
#   off             - the option is rejected server-side. Use to disable it instantly.
#   live            - real gateway (HDFC SmartGateway). Requires every HDFC_* value
#                     below; with any of them missing the online option stays off.
# Switch to "live" once the gateway is approved and the credentials are in place.
ONLINE_PAYMENT_MODE="dummy"

# HDFC SmartGateway (Phase 2 — see PAYMENT_FLOW_PLAN.md §12)
# The first five come from the config.json downloaded from the SmartGateway dashboard
# (Payments > Settings > Security). Leave them blank unless ONLINE_PAYMENT_MODE="live".
# Online payment must fail closed when these are unset — never treat blank as valid.
HDFC_MERCHANT_ID=""
HDFC_API_KEY=""
# Recorded for completeness; this design re-queries Order Status instead of trusting
# the return redirect, so no code reads it today.
HDFC_RESPONSE_KEY=""
# "hdfcmaster" in UAT; your merchant ID in production.
HDFC_PAYMENT_PAGE_CLIENT_ID="hdfcmaster"
# UAT: https://smartgateway.hdfcuat.bank.in   Production: https://smartgateway.hdfc.bank.in
HDFC_BASE_URL="https://smartgateway.hdfcuat.bank.in"
# We choose these two, then type the same values into the dashboard's Webhooks tab.
# HDFC authenticates its webhook calls to us with Basic auth using them.
HDFC_WEBHOOK_USER=""
HDFC_WEBHOOK_PASS=""

# How long a token is held while the patient is on the gateway's payment page (seconds).
# Separate from token_reservation_timeout_seconds, which is the walk-in hold tuned for
# someone standing at the front desk. A hosted checkout needs longer: a UPI collect
# request alone gives the payer about five minutes before any bank login or 3DS step.
# Too short and "money taken, no token, wallet credit" becomes the normal outcome.
HDFC_HOLD_SECONDS="1200"

# Absolute public origin of THIS deployment, used to build the gateway's return_url.
# HDFC requires HTTPS, with no port, no IP address and no query string. It cannot be
# derived from the incoming request, because the patient returns from a different site.
# Staging must set this to its own hostname or patients land back on production.
PUBLIC_BASE_URL="https://clinik.co.in"