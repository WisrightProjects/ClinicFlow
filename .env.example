# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Session Configuration
SESSION_SECRET="your-session-secret"

# Payments
# Controls the "Online" option on the booking payment screen:
#   dummy (default) - simulated payment. Books the token WITHOUT collecting any money.
#   off             - the option is rejected server-side. Use to disable it instantly.
#   live            - real gateway. Not implemented yet; currently behaves like "off".
# Switch to "off" or "live" once the real payment gateway is approved.
ONLINE_PAYMENT_MODE="dummy"